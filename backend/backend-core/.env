SERVER_PORT=8080
LOG_LEVEL=debug

POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/udpinterest?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=5
POSTGRES_TIMEOUT_SEC=10

# Redis
REDIS_ADDR=localhost:6379

# S3-compatible storage (MinIO)
S3_ENDPOINT=localhost:9000
S3_BUCKET=pinterest-media
S3_ACCESS_KEY=admin
S3_SECRET_KEY=supersecretpassword123
S3_REGION=us-east-1
S3_USE_SSL=false
# Для локальной разработки через Docker/браузер, публичный URL совпадает с эндпоинтом
S3_PUBLIC_URL=http://localhost:9000
S3_PRESIGN_EXPIRY=900

# # Cache TTL settings (в секундах)
# CACHE_PIN_TTL=300
# CACHE_LIST_TTL=60
# CACHE_USER_TTL=600
# CACHE_BOARD_TTL=300
